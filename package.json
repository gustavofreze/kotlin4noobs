{
  "name": "kotlin4noobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "astro build && pagefind --site dist",
    "check:budgets": "node tools/check-js-budgets.mjs",
    "check:examples": "node tools/check-examples.mjs",
    "dev": "astro dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "preview": "astro preview",
    "test": "vitest run",
    "typecheck": "astro check"
  },
  "dependencies": {
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.3.3",
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "pagefind": "1.5.2",
    "shiki": "4.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
