---
/**
 * The search over the notes, in one language.
 *
 * The index is built by Pagefind after the site, from the text of the topic pages only, and one index is
 * kept per language, so a reader on the English page searches the English notes. The page ships the
 * form and an empty list, and the script fetches the index the first time the reader types, so no other
 * page pays for it. A reader with a script opens the same search as a dialog from the bar of any page, so
 * this page serves a reader without one and a search shared by its address.
 */
import { pagePaths } from '../i18n'
import { getCopy, type Locale, MAIN_ID } from '../i18n/strings'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageCover from './PageCover.astro'
import SearchForm from './SearchForm.astro'

interface Props {
  locale: Locale
}
const { locale } = Astro.props
const copy = getCopy(locale)
const labels = copy.search
---

<BaseLayout locale={locale} title={labels.title} description={labels.lede} paths={pagePaths('search')} noindex searching>
  <main id={MAIN_ID} class="kt-page">
    <PageCover locale={locale} glyph="find()" title={labels.title} lede={labels.lede} />

    <div class="kt-wrap kt-main">
      <SearchForm locale={locale} id="search-term" />
    </div>
  </main>
</BaseLayout>

<script>
  import '../scripts/search.ts'
</script>
