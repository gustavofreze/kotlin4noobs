---
/**
 * The bar on top of every page: the brand that leads home, the way to search, and the theme and language
 * controls. It stays where it was drawn rather than following the reader, and the control in the corner
 * is the way back up to it.
 */
import { pageHref } from '../i18n'
import { getCopy, type Locale } from '../i18n/strings'
import BrandMark from './BrandMark.astro'
import Icon from './Icon.astro'
import LocaleMenu from './LocaleMenu.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  locale: Locale
  paths: Record<Locale, string>
  sections?: Record<Locale, readonly string[]> | undefined
}
const { locale, paths, sections } = Astro.props
const copy = getCopy(locale)
---

<header class="kt-bar">
  <div class="kt-wrap kt-bar__inner">
    <a href={pageHref(locale)} class="kt-bar__home" aria-label={`${copy.brand}: ${copy.nav.home}`}>
      <BrandMark label={copy.brand} />
    </a>
    <div class="kt-bar__controls">
      <div class="kt-bar__tools">
        <a href={pageHref(locale, 'search')} class="kt-bar__tool" aria-label={copy.nav.search} title={copy.nav.search}>
          <Icon name="search" size={18} />
        </a>
      </div>
      <ThemeToggle theme={copy.theme} />
      <LocaleMenu locale={locale} labels={copy.localeSwitch} paths={paths} sections={sections} />
    </div>
  </div>
</header>
